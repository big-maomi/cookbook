  "steps": [
    {
      "number": 1,
      "description": "将干燥虾皮放入锅中，用小火慢慢焙炒，炒至颜色微黄、散发出浓郁香气后盛出备用",
      "duration": "2-3分钟",
      "temperature": "小火",
      "tips": [
        "火候不要太大，否则虾皮容易焦糊变苦",
        "炒至虾皮变得酥脆、香味扑鼻即可"
      ]
    },
    {
      "number": 2,
      "description": "将干紫菜撕成小片或碎块，放入干锅中用小火微微烘烤，烤至紫菜变成浅绿色、散发出海苔香气",
      "duration": "1-2分钟",
      "temperature": "小火",
      "tips": [
        "紫菜变绿即表示已烤到位，不要烤过头",
        "也可以不烘烤直接使用，但烘烤后更香脆"
      ]
    },
    {
      "number": 3,
      "description": "将烤好的紫菜放入大碗中，倒入适量开水浸泡，用筷子搅拌，使其变软回软",
      "duration": "1-2分钟",
      "temperature": "开水",
      "tips": [
        "开水不要太多，刚好没过紫菜即可",
        "泡至紫菜完全软化后沥去多余水分"
      ]
    },
    {
      "number": 4,
      "description": "将泡软后的紫菜捞出，挤去多余水分，放入拌菜碗中",
      "duration": "",
      "temperature": "",
      "tips": [
        "不要挤得太干，保留少许水分口感更好"
      ]
    },
    {
      "number": 5,
      "description": "在紫菜中加入炒香的虾皮、蒜泥、葱花，再调入生抽3勺、香醋3勺、糖2勺、鸡粉1勺、香油3勺、白胡椒、海盐，充分搅拌均匀",
      "duration": "2分钟",
      "temperature": "",
      "tips": [
        "林大厨的黄金比例：生抽:醋:糖:鸡粉:香油 = 3:3:2:1:3",
        "一定要搅拌均匀，使每片紫菜都裹上调味料"
      ]
    },
    {
      "number": 6,
      "description": "摆盘装饰：将黄瓜切成薄片铺在盘底，胡萝卜片切成小太阳造型点缀，放上拌好的紫菜，摆出山水画般的造型",
      "duration": "3-5分钟",
      "temperature": "",
      "tips": [
        "装饰摆盘可选做，家常食用可直接盛盘",
        "摆盘灵感：传统中国画讲究留白，可自由发挥创意"
      ]
    }
  ],
  "key_points": [
    "虾皮必须小火焙香，这是整道菜鲜味和香气的关键",
    "紫菜用小火烘烤至变绿，烤出香气后再泡发，口感更好",
    "泡紫菜时用开水并快速搅拌，紫菜回软后立刻沥干，避免泡太久失去嚼劲",
    "调味黄金比例：生抽:醋:糖:鸡粉:香油 = 3:3:2:1:3",
    "蒜泥和葱花现切现用，香气才足",
    "摆盘注重留白和意境，可提升菜品档次"
  ],
  "common_mistakes": [
    "虾皮焙炒时火太大：容易焦糊发苦，正确做法是小火慢炒至微黄出香即可",
    "紫菜烘烤过头：烤太久会变黑发苦，正确做法是烤至变绿即停",
    "紫菜泡水太久：泡太久会软烂失去口感，正确做法是开水稍泡、变软即捞出沥干"
  ],
