  "steps": [
    {
      "number": 1,
      "description": "大蒜磨成蒜泥，鸡腿放入密封容器中，加入蒜泥、大量黑胡椒粉、1勺盐、1勺孜然粉（约5克）、适量干牛至叶、适量酱油、少许红糖、1个青柠的汁、1小勺黄芥末酱、多量橄榄油。",
      "duration": "5分钟",
      "temperature": "室温",
      "tips": [
        "大蒜磨成蒜泥比切碎更易入味",
        "干牛至叶是这道菜的灵魂香料，不可或缺"
      ]
    },
    {
      "number": 2,
      "description": "盖上密封盖，用力摇晃容器，让所有辛香料与鸡腿混合均匀。",
      "duration": "1-2分钟",
      "temperature": "室温",
      "tips": [
        "摇晃比搅拌更能让调料均匀附着"
      ]
    },
    {
      "number": 3,
      "description": "将腌制好的鸡腿放入冰箱冷藏腌制过夜（至少数小时），让味道充分渗透入骨。",
      "duration": "过夜（8小时以上）",
      "temperature": "冷藏",
      "tips": [
        "腌制过夜能让骨头都入味，风味最佳"
      ]
    },
    {
      "number": 4,
      "description": "撕一张油纸揉成团铺在空气炸锅的炸篮里，放上腌制好的鸡腿，表面再喷一层油。",
      "duration": "2分钟",
      "temperature": "室温",
      "tips": [
